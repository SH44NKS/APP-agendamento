# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL pública do app (usada nos links de retorno do login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar (as mesmas credenciais cadastradas no provedor Google do Supabase)
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Credenciais privadas de integração com o Power CRM (somente servidor; nunca use NEXT_PUBLIC_)
POWERCRM_TOKEN_FOCO=
POWERCRM_TOKEN_ESCUDO=
# Alternativa recomendada: a mesma ponte CRM usada pelo Sistema de Rastreamento A&O.
POWERCRM_BRIDGE_URL=https://controle-pendencias-foco-escudo.vercel.app/api/integrations/ao
POWERCRM_BRIDGE_SECRET=

# Notificações push Web (gere as chaves VAPID e cadastre-as somente na Vercel)
# A chave privada nunca deve ser enviada ao navegador ou ao GitHub.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@exemplo.com
